{
  "name": "satz",
  "productName": "satz",
  "version": "0.4.4",
  "description": "Dictation for Windows and Linux: talk, see the text, paste it where you were typing.",
  "author": "DPA+",
  "license": "MIT",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && python3 build/vcruntime.py && electron-builder --win zip --arm64 --x64",
    "dist:linux": "npm run build && electron-builder --linux deb tar.gz --arm64 --x64"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "sherpa-onnx-node": "1.13.8",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "plus.dpa.satz",
    "productName": "satz",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "assets/**",
      "package.json",
      "node_modules/uiohook-napi/**",
      "node_modules/node-gyp-build/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/onnxruntime-common/**",
      "!node_modules/sherpa-onnx-*/**",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/@huggingface/**",
      "!node_modules/sharp/**",
      "!node_modules/@img/**",
      "!node_modules/flatbuffers/**",
      "!node_modules/guid-typescript/**",
      "!node_modules/long/**",
      "!node_modules/platform/**",
      "!node_modules/protobufjs/**",
      "!node_modules/@protobufjs/**"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**",
      "node_modules/onnxruntime-node/**"
    ],
    "extraResources": [
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../Resources/Licenses",
        "to": "Licenses"
      }
    ],
    "win": {
      "signExecutable": false,
      "icon": "assets/icon.png",
      "artifactName": "satz-${version}-windows-${arch}.${ext}",
      "extraFiles": [
        {
          "from": "build/vcruntime/${arch}",
          "to": "resources/app.asar.unpacked/node_modules/onnxruntime-node/bin/napi-v6/win32/${arch}",
          "filter": [
            "*.dll"
          ]
        }
      ]
    },
    "linux": {
      "category": "Utility",
      "artifactName": "satz-${version}-linux-${arch}.${ext}",
      "icon": "assets/icon.png",
      "maintainer": "DPA+ <eli@dpa.plus>",
      "synopsis": "Dictation: talk, see the text, paste it where you were typing."
    },
    "npmRebuild": false,
    "afterPack": "build/after-pack.cjs",
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libxt6"
      ],
      "recommends": [
        "x11-utils",
        "xdotool"
      ]
    }
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "esbuild@0.28.2": true
  },
  "homepage": "https://github.com/dpa-plus/satz"
}
